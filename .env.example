# Copy this file to .env and replace with your actual Groq API key for live LLM chat.
# Deterministic calculators (/api/v1/budget, /api/v1/emergency-fund, /api/v1/mortgage)
# and the entire offline test suite work without a live API key.

GROQ_API_KEY=your_groq_api_key_placeholder
GROQ_MODEL=llama-3.3-70b-versatile
REQUEST_TIMEOUT_SECONDS=30.0
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000
RATE_LIMIT_PER_MINUTE=30
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0
LOG_LEVEL=INFO
